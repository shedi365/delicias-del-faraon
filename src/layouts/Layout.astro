---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Delicias del Faraón" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content="Dulces y comida árabe hechos en casa. CC La Vela, Nivel Sol." />
    <link rel="icon" type="image/webp" href="/images/logo.webp" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Josefin+Sans:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <!-- Si se entra con un enlace a una sección, se salta la animación de entrada -->
    <script is:inline>
      if (location.hash && location.hash !== "#" && location.hash !== "#inicio")
        document.documentElement.classList.add("skip-intro");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
